set(_libdir "@CMAKE_INSTALL_FULL_LIBDIR@")
set(_mpp_soname "@CMAKE_SHARED_LIBRARY_PREFIX@mpp@CMAKE_SHARED_LIBRARY_SUFFIX@.@PROJECT_VERSION_MAJOR@")
set(_stubs "@MPP_STUB_LIBS@")

foreach(_stub ${_stubs})
  set(_stub_path "${_libdir}/@CMAKE_SHARED_LIBRARY_PREFIX@${_stub}@CMAKE_SHARED_LIBRARY_SUFFIX@")
  if(EXISTS "${_stub_path}")
    file(REMOVE "${_stub_path}")
  endif()
  file(CREATE_LINK "${_mpp_soname}" "${_stub_path}" SYMBOLIC)
endforeach()
